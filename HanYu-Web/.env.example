# HanYu — Required Environment Variables
#
# Copy this file to .env.local or inject these via your secrets manager.
# NEVER commit actual values to source control.
#
# ─── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=postgresql://hanyu_app:<password>@<host>/<db>?sslmode=require

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 bytes (256-bit). Generate with:
#   openssl rand -base64 48
Jwt__SecretKey=<your-minimum-32-byte-secret-key>
Jwt__Issuer=HanYu.Api
Jwt__Audience=HanYu.Client
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
Security__AllowedOrigins__0=https://hanyu.vn
Security__AllowedOrigins__1=https://admin.hanyu.vn

# ─── Proxy Trust ───────────────────────────────────────────────────────────────
# Add the IP of your Nginx/load balancer to prevent IP spoofing.
Security__KnownProxies__0=10.0.0.1

# ─── Storage (S3/MinIO) ────────────────────────────────────────────────────────
Storage__AccessKey=<s3-access-key>
Storage__SecretKey=<s3-secret-key>
Storage__Region=ap-southeast-1
Storage__ExportBucketName=hanyu-exports
Storage__ExportUrlExpirationMinutes=15

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
Email__Host=smtp.example.com
Email__Port=587
Email__Username=<smtp-username>
Email__Password=<smtp-password>
Email__EnableSsl=true
Email__FromEmail=noreply@hanyu.vn
Email__FromName=HanYu

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────────
Sms__AccountSid=<twilio-account-sid>
Sms__AuthToken=<twilio-auth-token>
Sms__FromPhoneNumber=+84xxxxxxxxx

# ─── AI ────────────────────────────────────────────────────────────────────────
# Add your AI provider keys here when AI module is production-ready.
# Ai__OpenAiApiKey=<openai-key>
