<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Domain\Interfaces\Repositories\**" />
    <Compile Remove="Extensions\**" />
    <Compile Remove="Filters\**" />
    <Compile Remove="HealthChecks\**" />
    <Compile Remove="Middleware\**" />
    <Content Remove="Domain\Interfaces\Repositories\**" />
    <Content Remove="Extensions\**" />
    <Content Remove="Filters\**" />
    <Content Remove="HealthChecks\**" />
    <Content Remove="Middleware\**" />
    <EmbeddedResource Remove="Domain\Interfaces\Repositories\**" />
    <EmbeddedResource Remove="Extensions\**" />
    <EmbeddedResource Remove="Filters\**" />
    <EmbeddedResource Remove="HealthChecks\**" />
    <EmbeddedResource Remove="Middleware\**" />
    <None Remove="Domain\Interfaces\Repositories\**" />
    <None Remove="Extensions\**" />
    <None Remove="Filters\**" />
    <None Remove="HealthChecks\**" />
    <None Remove="Middleware\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="API Layer\Extensions\WebApplicationExtensions\" />
    <Folder Include="API Layer\Extensions\ServiceCollectionExtensions\" />
    <Folder Include="API Layer\Middleware\" />
    <Folder Include="API Layer\Filters\" />
    <Folder Include="API Layer\HealthChecks\" />
    <Folder Include="API Layer\Authorization\" />
    <Folder Include="API Layer\AuthorizationHandler\" />
    <Folder Include="API Layer\Attributes\" />
    <Folder Include="Application\DTO\" />
    <Folder Include="Application\Interfaces\" />
    <Folder Include="Application\Mappings\" />
    <Folder Include="Application\Exceptions\" />
    <Folder Include="Application\Common\" />
    <Folder Include="Application\Behaviors\" />
    <Folder Include="Application\Validators\" />
    <Folder Include="Application\Service\" />
    <Folder Include="Controllers\" />
    <Folder Include="Domain\Entities\" />
    <Folder Include="Domain\Enums\" />
    <Folder Include="Domain\Events\" />
    <Folder Include="Domain\Exceptions\" />
    <Folder Include="Domain\Constants\" />
    <Folder Include="Domain\ValueObjects\" />
    <Folder Include="Infrastructure\Configurations\" />
    <Folder Include="Infrastructure\Migration\" />
    <Folder Include="Infrastructure\Identity\" />
    <Folder Include="Infrastructure\Logging\" />
    <Folder Include="Infrastructure\Caching\" />
    <Folder Include="Infrastructure\ExternalServices\" />
    <Folder Include="Infrastructure\Outbox\" />
    <Folder Include="Infrastructure\Persistence\" />
    <Folder Include="Infrastructure\Repositories\" />
    <Folder Include="Infrastructure\Services\" />
    <Folder Include="Shared\Extensions\" />
  </ItemGroup>

</Project>
