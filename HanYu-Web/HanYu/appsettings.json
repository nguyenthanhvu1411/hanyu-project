  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Sms": {
    "AccountSid": "fake_sid",
    "AuthToken": "fake_token",
    "FromPhoneNumber": "+1234567890"
  },
  "Storage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-west-004",
    "ForcePathStyle": false,
    "ExportBucketName": "hanyu-private",
    "PublicBucketName": "hanyu-public",
    "PublicBaseUrl": "",
    "ExportUrlExpirationMinutes": 15,
    "ExportFileExpirationDays": 7
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
