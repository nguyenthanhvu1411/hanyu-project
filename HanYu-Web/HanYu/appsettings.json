{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=hanyu;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "HanYu.Api",
    "Audience": "HanYu.Client",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
