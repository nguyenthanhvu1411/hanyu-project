{
  "// IMPORTANT": "This file contains NON-SECRET production configuration only.",
  "// SECRETS": "JWT__SecretKey, ConnectionStrings__DefaultConnection, Storage__AccessKey, etc.",
  "// SECRETS_2": "must be injected via environment variables or secrets manager. NEVER commit secrets here.",

  "Jwt": {
    "Issuer": "HanYu.Api",
    "Audience": "HanYu.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Database": {
    "MaxPoolSize": 20,
    "MinPoolSize": 0,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "AutoMigrateOnStartup": false
  },
  "Security": {
    "AllowedOrigins": [
      "https://hanyu.vn",
      "https://admin.hanyu.vn"
    ],
    "MaxRequestBodySizeBytes": 2097152,
    "ForwardedHeadersLimit": 1,
    "KnownProxies": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "api.hanyu.vn",
  "VocabularyCache": {
    "DetailMinutes": 60,
    "ListMinutes": 15,
    "TaxonomyMinutes": 120,
    "GenerationDays": 7
  },
  "LessonCache": {
    "DetailMinutes": 60,
    "ListMinutes": 15,
    "GenerationDays": 7
  }
}
